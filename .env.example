# PostgreSQL Configuration
POSTGRES_DB=west_africa_economic
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Airflow Configuration
AIRFLOW_HOME=/airflow
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__CORE__DAGS_FOLDER=/airflow/dags
AIRFLOW__CORE__PLUGINS_FOLDER=/airflow/plugins
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__EXECUTOR=CeleryExecutor

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=postgresql://airflow:airflow@postgres:5432/west_africa_economic

# AWS Configuration (optionnel)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=west-africa-economic-data

# World Bank API Configuration
WORLD_BANK_API_TIMEOUT=30
WORLD_BANK_API_RETRIES=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Email Configuration (pour les alertes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=admin@example.com

# Monitoring and Alerting
SLACK_WEBHOOK_URL=your-slack-webhook-url
ENABLE_SENTRY=false
SENTRY_DSN=your-sentry-dsn
